# Actual environment — what the app will really boot with.
# Deliberately drifted from .env.example to demonstrate all three states:
#   STRIPE_SECRET is gone  -> MISSING
#   API_KEY is blank       -> EMPTY
#   SENTRY_DSN is new      -> EXTRA
DATABASE_URL=postgres://prod-db/myapp
API_KEY=
REDIS_URL=redis://prod:6379
LOG_LEVEL=debug
SENTRY_DSN=https://abc@sentry.io/123
